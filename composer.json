{
  "name": "ayagaidi/laravel-digital-menu",
  "type": "project",
  "description": "Open-source bilingual digital menu starter for cafes and restaurants, built with Laravel.",
  "keywords": [
    "laravel",
    "digital-menu",
    "qr-code",
    "arabic",
    "rtl",
    "restaurant",
    "cafe"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "simplesoftwareio/simple-qrcode": "^4.2"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5",
    "laravel/pint": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "test": "@php artisan test",
    "lint": "pint --test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
